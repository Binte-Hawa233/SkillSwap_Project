{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/dashboard.html", "dest": "/Dashboard.html" },
    { "src": "/community.html", "dest": "/Community.html" },
    { "src": "/COMMUNITY.html", "dest": "/Community.html" },
    { "src": "/DASHBOARD.html", "dest": "/Dashboard.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
